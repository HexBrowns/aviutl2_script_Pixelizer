AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
SOFTWARE.

（原作の配布ファイルには著作権表示の行が無く、作者名とライセンスは aviutl2-catalog の記載による。
年は確認できていない）
]]

--[[pixelshader@ps_mosaic_h:
Texture2D src_tex : register(t0);
Texture2D map_tex : register(t1);
SamplerState smp : register(s0);

cbuffer constant0 : register(b0) {
    float4 c0; // width, height, pixel size, color levels (0 = 無効)
    float4 c1; // tone steps, dither mode, dither strength, edge strength
    float4 c2; // alpha protect, alpha threshold, palette mode, color mode (0 = 中心 / 1 = 平均)
    float4 c3; // edge style, grid mode (0 = オブジェクト / 1 = 画面 / 2 = 中心), map origin x, map origin y
    float4 c4; // screenCenterX, screenCenterY, scaleX, scaleY
    float4 c5; // cosR, sinR, centerX, centerY
    float4 c6; // map width, map height, linear average (0 = ガンマのまま / 1 = リニア), color diff (色差。0 = RGB)
};

// ==== colorspace.hlsl ここから（AI/tools/sync_colorspace.py が書き写す。直すのは正本） ====
// colorspace.hlsl v1.01 — 色空間の変換・補間・色相回転・色差（HexBrowns）
// 正本: AI/tools/assets/colorspace.hlsl。各スクリプトの印の間へは AI/tools/sync_colorspace.py が書き写す（写しを直さない）
// Lua 側の同じ式: Script/EffectUtils_ColorSpace.lua。机上検証: AI/scripts/色空間拡張/verify_colorspace.py
//
// 色はすべてストレート（乗算済みでない）の sRGB（0〜1）で受け渡す。
// 色空間の番号（全スクリプト共通。@図形グラデーション_H と同じ）
//   0 sRGB / 1 リニア / 2 Oklab / 3 HSV / 4 HSL / 5 Lab / 6 LCh / 7 Oklch / 8 XYZ / 9 HWB
// 色相のある色空間（3 / 4 / 6 / 7 / 9）は x に色相（0〜1 周）を置く。
//   HSV (h, s, v) / HSL (h, s, l) / HWB (h, w, b) / LCh (h, C, L) / Oklch (h, C, L)
// Lab は D65 の白（XYZ を経由。CSS の lab() は D50 なので値は少し違う）。
// 色差の種類: 0 RGB / 1 YCbCr（色差だけ。明るさを見ない）/ 2 Oklab / 3 CIEDE2000。
//   どれも黒と白の差がおよそ 1 になるように割ってある（YCbCr は明るさを見ないので黒と白は 0）

#define CS_TAU 6.28318530717958647692

float cs_lin1(float c) {
    return c <= 0.04045 ? c / 12.92 : pow(abs((c + 0.055) / 1.055), 2.4);
}

float cs_srgb1(float c) {
    return c <= 0.0031308 ? c * 12.92 : 1.055 * pow(abs(c), 1.0 / 2.4) - 0.055;
}

float3 cs_to_linear(float3 c) {
    return float3(cs_lin1(c.r), cs_lin1(c.g), cs_lin1(c.b));
}

// リニア → sRGB。範囲外は切り詰める
float3 cs_to_srgb(float3 c) {
    float3 s = saturate(c);
    return float3(cs_srgb1(s.r), cs_srgb1(s.g), cs_srgb1(s.b));
}

float cs_cbrt(float x) {
    return sign(x) * pow(abs(x), 1.0 / 3.0);
}

// Oklab（Björn Ottosson, 2020）
float3 cs_linear_to_oklab(float3 c) {
    float l = 0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b;
    float m = 0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b;
    float s = 0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b;
    float l_ = cs_cbrt(l);
    float m_ = cs_cbrt(m);
    float s_ = cs_cbrt(s);
    return float3(
        0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_,
        1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_,
        0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_);
}

float3 cs_oklab_to_linear(float3 c) {
    float l_ = c.x + 0.3963377774 * c.y + 0.2158037573 * c.z;
    float m_ = c.x - 0.1055613458 * c.y - 0.0638541728 * c.z;
    float s_ = c.x - 0.0894841775 * c.y - 1.2914855480 * c.z;
    float l = l_ * l_ * l_;
    float m = m_ * m_ * m_;
    float s = s_ * s_ * s_;
    return float3(
         4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
        -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
        -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s);
}

// sRGB（D65）のリニア ⇔ XYZ（IEC 61966-2-1）
float3 cs_linear_to_xyz(float3 c) {
    return float3(
        0.4124564 * c.r + 0.3575761 * c.g + 0.1804375 * c.b,
        0.2126729 * c.r + 0.7151522 * c.g + 0.0721750 * c.b,
        0.0193339 * c.r + 0.1191920 * c.g + 0.9503041 * c.b);
}

float3 cs_xyz_to_linear(float3 c) {
    return float3(
         3.2404542 * c.x - 1.5371385 * c.y - 0.4985314 * c.z,
        -0.9692660 * c.x + 1.8760108 * c.y + 0.0415560 * c.z,
         0.0556434 * c.x - 0.2040259 * c.y + 1.0572252 * c.z);
}

// CIE 15: ε = 216/24389、κ = 24389/27
float cs_lab_f(float t) {
    return t > 0.008856452 ? cs_cbrt(t) : (903.2963 * t + 16.0) / 116.0;
}

float cs_lab_finv(float f) {
    float f3 = f * f * f;
    return f3 > 0.008856452 ? f3 : (116.0 * f - 16.0) / 903.2963;
}

float3 cs_xyz_to_lab(float3 c) {
    float fx = cs_lab_f(c.x / 0.95047);
    float fy = cs_lab_f(c.y);
    float fz = cs_lab_f(c.z / 1.08883);
    return float3(116.0 * fy - 16.0, 500.0 * (fx - fy), 200.0 * (fy - fz));
}

float3 cs_lab_to_xyz(float3 c) {
    float fy = (c.x + 16.0) / 116.0;
    float fx = fy + c.y / 500.0;
    float fz = fy - c.z / 200.0;
    return float3(cs_lab_finv(fx) * 0.95047, cs_lab_finv(fy), cs_lab_finv(fz) * 1.08883);
}

// (L, a, b) → (色相 0〜1 周, C, L)
float3 cs_lab_to_polar(float3 v) {
    return float3(frac(atan2(v.z, v.y) / CS_TAU + 1.0), length(float2(v.y, v.z)), v.x);
}

float3 cs_polar_to_lab(float3 p) {
    return float3(p.z, p.y * cos(p.x * CS_TAU), p.y * sin(p.x * CS_TAU));
}

float cs_hue_of(float3 c, float mx, float mn) {
    float d = mx - mn;
    float h = 0.0;
    if (d > 0.000001) {
        if (mx == c.r) {
            h = (c.g - c.b) / d;
        } else if (mx == c.g) {
            h = (c.b - c.r) / d + 2.0;
        } else {
            h = (c.r - c.g) / d + 4.0;
        }
    }
    return frac(h / 6.0 + 1.0);
}

float3 cs_hue_rgb(float h) {
    float3 p = abs(frac(float3(h, h, h) + float3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
    return saturate(p - 1.0);
}

float3 cs_rgb_to_hsv(float3 c) {
    float mx = max(c.r, max(c.g, c.b));
    float mn = min(c.r, min(c.g, c.b));
    float s = mx > 0.000001 ? (mx - mn) / mx : 0.0;
    return float3(cs_hue_of(c, mx, mn), s, mx);
}

float3 cs_hsv_to_rgb(float3 c) {
    return c.z * lerp(float3(1.0, 1.0, 1.0), cs_hue_rgb(c.x), saturate(c.y));
}

float3 cs_rgb_to_hsl(float3 c) {
    float mx = max(c.r, max(c.g, c.b));
    float mn = min(c.r, min(c.g, c.b));
    float l = (mx + mn) * 0.5;
    float den = 1.0 - abs(2.0 * l - 1.0);
    float s = den > 0.000001 ? (mx - mn) / den : 0.0;
    return float3(cs_hue_of(c, mx, mn), s, l);
}

float3 cs_hsl_to_rgb(float3 c) {
    float chroma = (1.0 - abs(2.0 * c.z - 1.0)) * saturate(c.y);
    return (cs_hue_rgb(c.x) - 0.5) * chroma + c.z;
}

float3 cs_rgb_to_hwb(float3 c) {
    float mx = max(c.r, max(c.g, c.b));
    float mn = min(c.r, min(c.g, c.b));
    return float3(cs_hue_of(c, mx, mn), mn, 1.0 - mx);
}

float3 cs_hwb_to_rgb(float3 c) {
    float w = max(c.y, 0.0);
    float b = max(c.z, 0.0);
    float sum = w + b;
    if (sum > 1.0) {
        w = w / sum;
        b = b / sum;
    }
    return cs_hue_rgb(c.x) * (1.0 - w - b) + w;
}

// リニアが sRGB の範囲に入っているか。float32 の誤差の分だけ、値の大きさに比例して許す
// （決まった幅で許すと、値の小さい暗い色で切り詰めたときに色相がずれる）
bool cs_in_gamut(float3 lin) {
    float e = max(abs(lin.r), max(abs(lin.g), abs(lin.b))) * 0.000002 + 0.000000001;
    return all(lin >= -e) && all(lin <= 1.0 + e);
}

// Oklch (h, C, L) をリニアへ。sRGB に無い色は、明るさと色相を保ったまま C を下げて収める（二分探索 16 回）
float3 cs_oklch_to_linear_fit(float3 p) {
    float3 lab = cs_polar_to_lab(p);
    float3 lin = cs_oklab_to_linear(lab);
    if (!cs_in_gamut(lin)) {
        float lo = 0.0;
        float hi = max(p.y, 0.0);
        [loop]
        for (int i = 0; i < 16; i++) {
            float mid = (lo + hi) * 0.5;
            float3 t = cs_oklab_to_linear(cs_polar_to_lab(float3(p.x, mid, p.z)));
            if (cs_in_gamut(t)) {
                lo = mid;
            } else {
                hi = mid;
            }
        }
        lin = cs_oklab_to_linear(cs_polar_to_lab(float3(p.x, lo, p.z)));
    }
    return lin;
}

// sRGB → 色空間の値
float3 cs_to_space(float3 c, float space) {
    float3 r = c;
    if (space > 8.5) {
        r = cs_rgb_to_hwb(c);
    } else if (space > 7.5) {
        r = cs_linear_to_xyz(cs_to_linear(c));
    } else if (space > 6.5) {
        r = cs_lab_to_polar(cs_linear_to_oklab(cs_to_linear(c)));
    } else if (space > 5.5) {
        r = cs_lab_to_polar(cs_xyz_to_lab(cs_linear_to_xyz(cs_to_linear(c))));
    } else if (space > 4.5) {
        r = cs_xyz_to_lab(cs_linear_to_xyz(cs_to_linear(c)));
    } else if (space > 3.5) {
        r = cs_rgb_to_hsl(c);
    } else if (space > 2.5) {
        r = cs_rgb_to_hsv(c);
    } else if (space > 1.5) {
        r = cs_linear_to_oklab(cs_to_linear(c));
    } else if (space > 0.5) {
        r = cs_to_linear(c);
    }
    return r;
}

// 色空間の値 → sRGB（0〜1）。Oklch だけは C を下げて sRGB に収め、ほかは切り詰める
float3 cs_from_space(float3 v, float space) {
    float3 r = saturate(v);
    if (space > 8.5) {
        r = saturate(cs_hwb_to_rgb(v));
    } else if (space > 7.5) {
        r = cs_to_srgb(cs_xyz_to_linear(v));
    } else if (space > 6.5) {
        r = cs_to_srgb(cs_oklch_to_linear_fit(v));
    } else if (space > 5.5) {
        r = cs_to_srgb(cs_xyz_to_linear(cs_lab_to_xyz(cs_polar_to_lab(v))));
    } else if (space > 4.5) {
        r = cs_to_srgb(cs_xyz_to_linear(cs_lab_to_xyz(v)));
    } else if (space > 3.5) {
        r = saturate(cs_hsl_to_rgb(v));
    } else if (space > 2.5) {
        r = saturate(cs_hsv_to_rgb(v));
    } else if (space > 1.5) {
        r = cs_to_srgb(cs_oklab_to_linear(v));
    } else if (space > 0.5) {
        r = cs_to_srgb(v);
    }
    return r;
}

bool cs_is_polar(float space) {
    return (space > 2.5 && space < 4.5) || (space > 5.5 && space < 7.5) || space > 8.5;
}

// 色相を持たない（無彩色の）値か
bool cs_no_hue(float3 v, float space) {
    bool r = v.y < 0.0001;
    if (space > 8.5) {
        r = v.y + v.z > 0.9999;
    } else if (space > 6.5) {
        r = v.y < 0.0002;
    } else if (space > 5.5) {
        r = v.y < 0.05;
    }
    return r;
}

// 色空間の値どうしの補間。a0 / a1 は不透明度で、乗算済みのまま混ぜる（透明へ向かっても黒ずまない。CSS と同じ）。
// 色相のある色空間では色相だけは乗算せず、無彩色の側は相手の色相に合わせる。hue_long > 0.5 で長い方を回る。
// 戻り値の xyz は色空間の値（cs_from_space で sRGB に戻す）、w は不透明度
float4 cs_mix_values(float3 v0, float a0, float3 v1, float a1, float u, float space, float hue_long) {
    float a = lerp(a0, a1, u);
    float3 v = v0;
    if (cs_is_polar(space)) {
        float3 x0 = v0;
        float3 x1 = v1;
        if (cs_no_hue(x0, space)) {
            x0.x = x1.x;
        } else if (cs_no_hue(x1, space)) {
            x1.x = x0.x;
        }
        float dh = x1.x - x0.x;
        if (hue_long > 0.5) {
            if (dh > 0.0 && dh < 0.5) {
                dh = dh - 1.0;
            } else if (dh <= 0.0 && dh > -0.5) {
                dh = dh + 1.0;
            }
        } else {
            if (dh > 0.5) {
                dh = dh - 1.0;
            } else if (dh < -0.5) {
                dh = dh + 1.0;
            }
        }
        float2 yz = lerp(float2(x0.y, x0.z) * a0, float2(x1.y, x1.z) * a1, u);
        yz = a > 0.000001 ? yz / a : lerp(float2(x0.y, x0.z), float2(x1.y, x1.z), u);
        v = float3(frac(x0.x + dh * u + 1.0), yz.x, yz.y);
    } else {
        float3 pc = lerp(v0 * a0, v1 * a1, u);
        v = a > 0.000001 ? pc / a : lerp(v0, v1, u);
    }
    return float4(v, a);
}

// ストレートの sRGB 2 色を色空間で補間する。戻り値はストレートの sRGB と不透明度
float4 cs_mix(float4 c0, float4 c1, float u, float space, float hue_long) {
    float3 v0 = cs_to_space(c0.rgb, space);
    float3 v1 = cs_to_space(c1.rgb, space);
    float4 m = cs_mix_values(v0, c0.a, v1, c1.a, u, space, hue_long);
    return float4(cs_from_space(m.xyz, space), m.w);
}

// 色相を turns 周だけ回す。space: 3 HSV / 4 HSL / 6 LCh / 7 Oklch / 9 HWB（それ以外は HSV）。
// Oklch と LCh は明るさと C を保つ（Oklch は sRGB に無ければ C を下げる）
float3 cs_hue_shift(float3 c, float turns, float space) {
    float sp = cs_is_polar(space) ? space : 3.0;
    float3 v = cs_to_space(c, sp);
    v.x = frac(v.x + turns + 1.0);
    return cs_from_space(v, sp);
}

// 鮮やかさを k 倍にする。space: 0 sRGB（Rec.709 の輝度との間で伸ばす。従来の式）/ 3 HSV / 4 HSL / 6 LCh / 7 Oklch
float3 cs_scale_chroma(float3 c, float k, float space) {
    float3 r = c;
    if (cs_is_polar(space) && space < 8.5) {
        float3 v = cs_to_space(c, space);
        v.y = max(v.y * k, 0.0);
        r = cs_from_space(v, space);
    } else {
        float y = dot(c, float3(0.2126, 0.7152, 0.0722));
        r = saturate(lerp(float3(y, y, y), c, k));
    }
    return r;
}

// 明るさ（0〜1）。space: 0 sRGB（Rec.709 をガンマのまま。従来の式）/ 1 リニア（相対輝度 Y）/ 2・7 Oklab の L / 5・6 Lab の L / 3 HSV の V / 4 HSL の L
float cs_lightness(float3 c, float space) {
    float r = dot(c, float3(0.2126, 0.7152, 0.0722));
    if (space > 6.5 && space < 7.5) {
        r = cs_linear_to_oklab(cs_to_linear(c)).x;
    } else if (space > 4.5 && space < 6.5) {
        r = cs_xyz_to_lab(cs_linear_to_xyz(cs_to_linear(c))).x / 100.0;
    } else if (space > 3.5 && space < 4.5) {
        r = cs_rgb_to_hsl(c).z;
    } else if (space > 2.5 && space < 3.5) {
        r = max(c.r, max(c.g, c.b));
    } else if (space > 1.5 && space < 2.5) {
        r = cs_linear_to_oklab(cs_to_linear(c)).x;
    } else if (space > 0.5 && space < 1.5) {
        r = dot(cs_to_linear(c), float3(0.2126729, 0.7151522, 0.0721750));
    }
    return r;
}

// CIEDE2000（Sharma, Wu, Dalal 2005）。Lab（D65）の値どうし。戻り値は ΔE00（0〜100 程度）
float cs_ciede2000(float3 lab1, float3 lab2) {
    float c1 = length(lab1.yz);
    float c2 = length(lab2.yz);
    float cb = (c1 + c2) * 0.5;
    float cb7 = pow(cb, 7.0);
    float g = 0.5 * (1.0 - sqrt(cb7 / (cb7 + 6103515625.0)));
    float a1p = lab1.y * (1.0 + g);
    float a2p = lab2.y * (1.0 + g);
    float c1p = length(float2(a1p, lab1.z));
    float c2p = length(float2(a2p, lab2.z));
    float h1p = (abs(a1p) + abs(lab1.z)) > 0.0 ? atan2(lab1.z, a1p) : 0.0;
    float h2p = (abs(a2p) + abs(lab2.z)) > 0.0 ? atan2(lab2.z, a2p) : 0.0;
    if (h1p < 0.0) {
        h1p = h1p + CS_TAU;
    }
    if (h2p < 0.0) {
        h2p = h2p + CS_TAU;
    }
    float dl = lab2.x - lab1.x;
    float dc = c2p - c1p;
    float dh = 0.0;
    float hbp = h1p + h2p;
    if (c1p * c2p > 0.0) {
        dh = h2p - h1p;
        if (dh > 3.14159265) {
            dh = dh - CS_TAU;
        } else if (dh < -3.14159265) {
            dh = dh + CS_TAU;
        }
        if (abs(h1p - h2p) > 3.14159265) {
            hbp = (h1p + h2p < CS_TAU) ? (h1p + h2p + CS_TAU) * 0.5 : (h1p + h2p - CS_TAU) * 0.5;
        } else {
            hbp = (h1p + h2p) * 0.5;
        }
    }
    float dhh = 2.0 * sqrt(c1p * c2p) * sin(dh * 0.5);
    float lbp = (lab1.x + lab2.x) * 0.5;
    float cbp = (c1p + c2p) * 0.5;
    float t = 1.0 - 0.17 * cos(hbp - 0.523598776) + 0.24 * cos(2.0 * hbp)
        + 0.32 * cos(3.0 * hbp + 0.104719755) - 0.20 * cos(4.0 * hbp - 1.099557429);
    float dtheta = 0.523598776 * exp(-pow((hbp * 57.29577951 - 275.0) / 25.0, 2.0));
    float cbp7 = pow(cbp, 7.0);
    float rc = 2.0 * sqrt(cbp7 / (cbp7 + 6103515625.0));
    float l50 = (lbp - 50.0) * (lbp - 50.0);
    float sl = 1.0 + 0.015 * l50 / sqrt(20.0 + l50);
    float sc = 1.0 + 0.045 * cbp;
    float sh = 1.0 + 0.015 * cbp * t;
    float rt = -sin(2.0 * dtheta) * rc;
    float tl = dl / sl;
    float tc = dc / sc;
    float th = dhh / sh;
    return sqrt(max(tl * tl + tc * tc + th * th + rt * tc * th, 0.0));
}

// 2 色の差。metric: 0 RGB / 1 YCbCr（BT.709 の色差だけ）/ 2 Oklab / 3 CIEDE2000。黒と白の差がおよそ 1
float cs_distance(float3 c0, float3 c1, float metric) {
    float r = length(c0 - c1) * 0.57735027;
    if (metric > 2.5) {
        float3 l0 = cs_xyz_to_lab(cs_linear_to_xyz(cs_to_linear(c0)));
        float3 l1 = cs_xyz_to_lab(cs_linear_to_xyz(cs_to_linear(c1)));
        r = cs_ciede2000(l0, l1) / 100.0;
    } else if (metric > 1.5) {
        r = length(cs_linear_to_oklab(cs_to_linear(c0)) - cs_linear_to_oklab(cs_to_linear(c1)));
    } else if (metric > 0.5) {
        float3 d = c0 - c1;
        float cb = dot(d, float3(-0.1146, -0.3854, 0.5));
        float cr = dot(d, float3(0.5, -0.4542, -0.0458));
        r = length(float2(cb, cr)) * 1.41421356;
    }
    return r;
}
// ==== colorspace.hlsl ここまで ====

float get_luma(float3 c) {
    return dot(c, float3(0.299, 0.587, 0.114));
}

float3 get_straight_rgb(float4 c) {
    if (c.a <= 0.00001) {
        return float3(0.0, 0.0, 0.0);
    }
    return saturate(c.rgb / c.a);
}

float sample_straight_luma(float2 uv) {
    float4 s = src_tex.SampleLevel(smp, saturate(uv), 0.0);
    if (s.a <= 0.00001) {
        return 0.0;
    }
    return get_luma(get_straight_rgb(s));
}

float sample_alpha(float2 uv) {
    return src_tex.SampleLevel(smp, saturate(uv), 0.0).a;
}

float3 quantize_rgb(float3 rgb, float levels) {
    levels = max(levels, 2.0);
    float d = levels - 1.0;
    return floor(saturate(rgb) * d + 0.5) / d;
}

float3 quantize_tone(float3 rgb, float steps) {
    if (steps < 2.0) {
        return rgb;
    }

    float lum = get_luma(rgb);
    if (lum <= 0.00001) {
        return rgb;
    }

    float d = steps - 1.0;
    float q = floor(saturate(lum) * d + 0.5) / d;
    return saturate(rgb * (q / lum));
}

// 0 以上の n では fmod(n, m) と同じ値。負のブロック番号（オブジェクト中心・画面の左上より外）でも
// 周期が崩れないように、切り捨て除算ではなく floor で剰余を取る
float pos_mod(float v, float m) {
    float n = floor(v);
    return n - m * floor(n / m);
}

float bayer2(float2 p) {
    float x = pos_mod(p.x, 2.0);
    float y = pos_mod(p.y, 2.0);

    if (y < 0.5) {
        if (x < 0.5) return 0.0 / 4.0;
        return 2.0 / 4.0;
    } else {
        if (x < 0.5) return 3.0 / 4.0;
        return 1.0 / 4.0;
    }
}

float bayer4(float2 p) {
    float x = pos_mod(p.x, 4.0);
    float y = pos_mod(p.y, 4.0);

    if (y < 0.5) {
        if (x < 0.5) return  0.0 / 16.0;
        if (x < 1.5) return  8.0 / 16.0;
        if (x < 2.5) return  2.0 / 16.0;
        return 10.0 / 16.0;
    }
    if (y < 1.5) {
        if (x < 0.5) return 12.0 / 16.0;
        if (x < 1.5) return  4.0 / 16.0;
        if (x < 2.5) return 14.0 / 16.0;
        return  6.0 / 16.0;
    }
    if (y < 2.5) {
        if (x < 0.5) return  3.0 / 16.0;
        if (x < 1.5) return 11.0 / 16.0;
        if (x < 2.5) return  1.0 / 16.0;
        return  9.0 / 16.0;
    }

    if (x < 0.5) return 15.0 / 16.0;
    if (x < 1.5) return  7.0 / 16.0;
    if (x < 2.5) return 13.0 / 16.0;
    return  5.0 / 16.0;
}

float ordered_dither(float2 blockPos, float mode) {
    if (mode < 0.5) {
        return 0.0;
    }
    if (mode < 1.5) {
        return bayer2(blockPos) - 0.375;
    }
    return bayer4(blockPos) - 0.46875;
}

float simple_edge(float2 uv, float2 stepUV) {
    float a0 = sample_alpha(uv);

    float l1 = sample_straight_luma(uv + float2(-stepUV.x, 0.0));
    float l2 = sample_straight_luma(uv + float2( stepUV.x, 0.0));
    float l3 = sample_straight_luma(uv + float2(0.0, -stepUV.y));
    float l4 = sample_straight_luma(uv + float2(0.0,  stepUV.y));

    float a1 = sample_alpha(uv + float2(-stepUV.x, 0.0));
    float a2 = sample_alpha(uv + float2( stepUV.x, 0.0));
    float a3 = sample_alpha(uv + float2(0.0, -stepUV.y));
    float a4 = sample_alpha(uv + float2(0.0,  stepUV.y));

    float lumDiff = abs(l1 - l2) + abs(l3 - l4);
    float alphaDiff = abs(a1 - a2) + abs(a3 - a4) + abs(a0 - a1) + abs(a0 - a2) + abs(a0 - a3) + abs(a0 - a4);

    return saturate(lumDiff * 1.2 + alphaDiff * 1.0);
}

float dist2(float3 a, float3 b) {
    float3 d = a - b;
    return dot(d, d);
}

float3 nearest_palette_color(float3 rgb, float3 p0, float3 p1, float3 p2, float3 p3) {
    float3 best = p0;
    float bestD = dist2(rgb, p0);
    float d1 = dist2(rgb, p1);
    float d2 = dist2(rgb, p2);
    float d3 = dist2(rgb, p3);

    if (d1 < bestD) { bestD = d1; best = p1; }
    if (d2 < bestD) { bestD = d2; best = p2; }
    if (d3 < bestD) { best = p3; }

    return best;
}

float3 palette_gameboy(float3 rgb) {
    float3 p0 = float3(15.0, 56.0, 15.0) / 255.0;
    float3 p1 = float3(48.0, 98.0, 48.0) / 255.0;
    float3 p2 = float3(139.0, 172.0, 15.0) / 255.0;
    float3 p3 = float3(155.0, 188.0, 15.0) / 255.0;
    return nearest_palette_color(rgb, p0, p1, p2, p3);
}

// v1.10: GameBoy パレットの最近傍を色差（cs_distance。1 YCbCr / 2 Oklab / 3 CIEDE2000）で選ぶ。
// 色差=RGB（0）はここを通らず、上の nearest_palette_color（原作のまま）を使う。
// 同じ距離なら先の色を採る（nearest_palette_color と同じ）。cs_distance を 1 か所にするためループで回す
// （4 か所に展開すると fxc のコンパイルが v1.01 の 86 ms → 321 ms に重くなった。1 か所で 203 ms）
float3 palette_gameboy_cs(float3 rgb, float metric) {
    float3 p0 = float3(15.0, 56.0, 15.0) / 255.0;
    float3 p1 = float3(48.0, 98.0, 48.0) / 255.0;
    float3 p2 = float3(139.0, 172.0, 15.0) / 255.0;
    float3 p3 = float3(155.0, 188.0, 15.0) / 255.0;
    float3 best = p0;
    float bestD = 1.0e30;
    [loop]
    for (int i = 0; i < 4; i++) {
        float3 p = p3;
        if (i == 0) {
            p = p0;
        } else if (i == 1) {
            p = p1;
        } else if (i == 2) {
            p = p2;
        }
        float d = cs_distance(rgb, p, metric);
        if (d < bestD) {
            bestD = d;
            best = p;
        }
    }
    return best;
}

float3 palette_gray4(float3 rgb) {
    float lum = get_luma(rgb);
    float q = floor(saturate(lum) * 3.0 + 0.5) / 3.0;
    return float3(q, q, q);
}

float3 quantize_565(float3 rgb) {
    float r = floor(saturate(rgb.r) * 31.0 + 0.5) / 31.0;
    float g = floor(saturate(rgb.g) * 63.0 + 0.5) / 63.0;
    float b = floor(saturate(rgb.b) * 31.0 + 0.5) / 31.0;
    return float3(r, g, b);
}

float3 apply_palette_mode(float3 rgb, float paletteMode, float levels) {
    if (paletteMode > 0.5 && paletteMode < 1.5) {
        return palette_gameboy(rgb);
    }
    if (paletteMode >= 1.5 && paletteMode < 2.5) {
        return quantize_565(rgb);
    }
    if (paletteMode >= 2.5) {
        return palette_gray4(rgb);
    }
    return quantize_rgb(rgb, levels);
}

float2 object_grid_sample_uv(float2 uv, float2 resolution, float psize) {
    float2 sourcePos = uv * resolution;
    float2 blockPos = floor(sourcePos / psize);
    float2 samplePos = blockPos * psize + psize * 0.5;
    samplePos.x = min(samplePos.x, resolution.x - 0.5);
    samplePos.y = min(samplePos.y, resolution.y - 0.5);
    return samplePos / resolution;
}

// 格子の線がオブジェクトの中心を通る（ピクセル化.anm2 と同じ）。ブロック番号は負になりうる
float2 center_grid_sample_uv(float2 blockPos, float2 resolution, float psize) {
    float2 samplePos = resolution * 0.5 + blockPos * psize + psize * 0.5;
    samplePos.x = clamp(samplePos.x, 0.5, resolution.x - 0.5);
    samplePos.y = clamp(samplePos.y, 0.5, resolution.y - 0.5);
    return samplePos / resolution;
}

float2 object_pixel_to_screen(float2 sourcePos, float2 resolution) {
    float localX = (sourcePos.x + 0.5 - resolution.x * 0.5 - c5.z) * c4.z;
    float localY = (sourcePos.y + 0.5 - resolution.y * 0.5 - c5.w) * c4.w;

    return float2(
        c4.x + localX * c5.x - localY * c5.y,
        c4.y + localX * c5.y + localY * c5.x
    );
}

float2 screen_to_object_pixel(float2 screenPos, float2 resolution) {
    float dx = screenPos.x - c4.x;
    float dy = screenPos.y - c4.y;

    float invX = dx * c5.x + dy * c5.y;
    float invY = -dx * c5.y + dy * c5.x;

    float safeScaleX = c4.z;
    float safeScaleY = c4.w;

    if (abs(safeScaleX) < 0.00001) {
        safeScaleX = 0.00001;
    }
    if (abs(safeScaleY) < 0.00001) {
        safeScaleY = 0.00001;
    }

    return float2(
        invX / safeScaleX + resolution.x * 0.5 + c5.z - 0.5,
        invY / safeScaleY + resolution.y * 0.5 + c5.w - 0.5
    );
}

float2 screen_grid_sample_uv(float2 uv, float2 resolution, float psize) {
    float2 sourcePos = uv * resolution;
    float2 screenPos = object_pixel_to_screen(sourcePos, resolution);

    float2 snappedScreen = floor(screenPos / psize) * psize + psize * 0.5;
    float2 samplePos = screen_to_object_pixel(snappedScreen, resolution);

    samplePos.x = clamp(samplePos.x, 0.5, resolution.x - 0.5);
    samplePos.y = clamp(samplePos.y, 0.5, resolution.y - 0.5);

    return samplePos / resolution;
}

float2 screen_grid_index(float2 uv, float2 resolution, float psize) {
    float2 sourcePos = uv * resolution;
    float2 screenPos = object_pixel_to_screen(sourcePos, resolution);
    return floor(screenPos / psize);
}

// 画素の中心（sourcePos = x + 0.5）が属するブロックの番号。
// 正本はここ。ps_mosaic_h_average に同じ関数を複製してある（変更時は両方直す）
float2 block_index(float2 sourcePos, float2 resolution, float psize, float gridMode) {
    float2 b = floor(sourcePos / psize);
    if (gridMode > 1.5) {
        b = floor((sourcePos - resolution * 0.5) / psize);
    } else if (gridMode > 0.5) {
        b = floor(object_pixel_to_screen(sourcePos, resolution) / psize);
    }
    return b;
}

float4 ps_mosaic_h(float4 pos : SV_Position, float2 uv : TEXCOORD) : SV_Target {
    float width  = max(c0.x, 1.0);
    float height = max(c0.y, 1.0);
    float psize  = max(c0.z, 1.0);
    float levels = c0.w;

    float toneSteps      = max(c1.x, 0.0);
    float ditherMode     = c1.y;
    float ditherStrength = saturate(c1.z / 100.0);
    float edgeStrength   = saturate(c1.w / 100.0);

    float alphaProtect   = c2.x;
    float alphaThreshold = saturate(c2.y / 255.0);
    float paletteMode    = c2.z;
    float colorMode      = c2.w;

    float edgeStyle      = c3.x;
    float gridMode       = c3.y;
    float colorDiff      = c6.w;

    // 色数 2 以上か、デフォルト以外のパレットのときだけ色を 0〜1 に収める
    bool clampColor = (levels >= 2.0) || (paletteMode > 0.5);

    float2 resolution = float2(width, height);
    float2 sourcePos = uv * resolution;

    float2 blockPos = floor(sourcePos / psize);
    float2 sampleUV = object_grid_sample_uv(uv, resolution, psize);

    if (gridMode > 1.5) {
        blockPos = floor((pos.xy - resolution * 0.5) / psize);
        sampleUV = center_grid_sample_uv(blockPos, resolution, psize);
    } else if (gridMode > 0.5) {
        sampleUV = screen_grid_sample_uv(uv, resolution, psize);
        blockPos = screen_grid_index(uv, resolution, psize);
    }

    float4 src = src_tex.SampleLevel(smp, sampleUV, 0.0);

    if (colorMode > 0.5) {
        // 平均は縮小バッファ（1 ブロック 1 画素）から引く。番号は画素の中心（pos.xy）で決める
        // ＝縮小バッファを書いたパスと同じ入力。空のブロック（アルファ -1）なら中心の色のまま
        float2 mapIndex = block_index(pos.xy, resolution, psize, gridMode) - c3.zw;
        if (mapIndex.x >= 0.0 && mapIndex.y >= 0.0 && mapIndex.x < c6.x && mapIndex.y < c6.y) {
            float4 avg = map_tex.Load(int3((int)mapIndex.x, (int)mapIndex.y, 0));
            if (avg.a >= 0.0) {
                src = avg;
            }
        }
    }

    if (src.a <= 0.00001) {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    if (alphaProtect > 0.5 && src.a <= alphaThreshold) {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    float3 rgb = src.rgb / src.a;
    if (clampColor) {
        rgb = saturate(rgb);
    }

    rgb = quantize_tone(rgb, toneSteps);

    // ディザリングの振幅は色数から。色数=無効 ならパレットの段数から取る（デフォルトは掛けない）
    float ditherLevels = levels;
    if (levels < 2.0) {
        ditherLevels = 0.0;
        if (paletteMode > 0.5 && paletteMode < 1.5) {
            ditherLevels = 4.0;
        } else if (paletteMode >= 1.5 && paletteMode < 2.5) {
            ditherLevels = 32.0;
        } else if (paletteMode >= 2.5) {
            ditherLevels = 4.0;
        }
    }

    if (ditherMode > 0.5 && ditherStrength > 0.0 && ditherLevels >= 2.0) {
        float dv = ordered_dither(blockPos, ditherMode);
        float amplitude = ditherStrength / max(ditherLevels - 1.0, 1.0);
        rgb = saturate(rgb + dv * amplitude);
    }

    float3 rgbBeforePalette = rgb;
    if (clampColor) {
        rgb = apply_palette_mode(rgb, paletteMode, levels);
    }
    // v1.10: 色差=RGB 以外の GameBoy は、パレットの最近傍を色差で選び直す（RGB は上のまま。v1.01 と同じ）
    if (colorDiff > 0.5 && paletteMode > 0.5 && paletteMode < 1.5) {
        rgb = palette_gameboy_cs(rgbBeforePalette, colorDiff);
    }

    if (edgeStrength > 0.0) {
        float2 edgeStep = float2(psize / width, psize / height);
        float e = simple_edge(sampleUV, edgeStep);

        if (edgeStyle > 0.5) {
            // Strong edge mode: draw a darker contour instead of dimming the whole area.
            float edgeMask = saturate((e - 0.08) * 2.2) * edgeStrength;
            rgb = lerp(rgb, rgb * 0.08, edgeMask);
        } else {
            // Soft edge mode: darken detected edges conservatively.
            rgb *= saturate(1.0 - e * edgeStrength * 0.70);
        }
    }

    if (clampColor) {
        rgb = saturate(rgb);
    }

    return float4(rgb * src.a, src.a);
}
]]

--[[pixelshader@ps_mosaic_h_average:
Texture2D src_tex : register(t0);

cbuffer constant0 : register(b0) {
    float4 c0; // width, height, pixel size, color levels
    float4 c1; // tone steps, dither mode, dither strength, edge strength
    float4 c2; // alpha protect, alpha threshold, palette mode, color mode
    float4 c3; // edge style, grid mode, map origin x, map origin y
    float4 c4; // screenCenterX, screenCenterY, scaleX, scaleY
    float4 c5; // cosR, sinR, centerX, centerY
    float4 c6; // map width, map height, linear average (0 = ガンマのまま / 1 = リニア), color diff
};

// ==== colorspace.hlsl ここから（AI/tools/sync_colorspace.py が書き写す。直すのは正本） ====
// colorspace.hlsl v1.01 — 色空間の変換・補間・色相回転・色差（HexBrowns）
// 正本: AI/tools/assets/colorspace.hlsl。各スクリプトの印の間へは AI/tools/sync_colorspace.py が書き写す（写しを直さない）
// Lua 側の同じ式: Script/EffectUtils_ColorSpace.lua。机上検証: AI/scripts/色空間拡張/verify_colorspace.py
//
// 色はすべてストレート（乗算済みでない）の sRGB（0〜1）で受け渡す。
// 色空間の番号（全スクリプト共通。@図形グラデーション_H と同じ）
//   0 sRGB / 1 リニア / 2 Oklab / 3 HSV / 4 HSL / 5 Lab / 6 LCh / 7 Oklch / 8 XYZ / 9 HWB
// 色相のある色空間（3 / 4 / 6 / 7 / 9）は x に色相（0〜1 周）を置く。
//   HSV (h, s, v) / HSL (h, s, l) / HWB (h, w, b) / LCh (h, C, L) / Oklch (h, C, L)
// Lab は D65 の白（XYZ を経由。CSS の lab() は D50 なので値は少し違う）。
// 色差の種類: 0 RGB / 1 YCbCr（色差だけ。明るさを見ない）/ 2 Oklab / 3 CIEDE2000。
//   どれも黒と白の差がおよそ 1 になるように割ってある（YCbCr は明るさを見ないので黒と白は 0）

#define CS_TAU 6.28318530717958647692

float cs_lin1(float c) {
    return c <= 0.04045 ? c / 12.92 : pow(abs((c + 0.055) / 1.055), 2.4);
}

float cs_srgb1(float c) {
    return c <= 0.0031308 ? c * 12.92 : 1.055 * pow(abs(c), 1.0 / 2.4) - 0.055;
}

float3 cs_to_linear(float3 c) {
    return float3(cs_lin1(c.r), cs_lin1(c.g), cs_lin1(c.b));
}

// リニア → sRGB。範囲外は切り詰める
float3 cs_to_srgb(float3 c) {
    float3 s = saturate(c);
    return float3(cs_srgb1(s.r), cs_srgb1(s.g), cs_srgb1(s.b));
}

float cs_cbrt(float x) {
    return sign(x) * pow(abs(x), 1.0 / 3.0);
}

// Oklab（Björn Ottosson, 2020）
float3 cs_linear_to_oklab(float3 c) {
    float l = 0.4122214708 * c.r + 0.5363325363 * c.g + 0.0514459929 * c.b;
    float m = 0.2119034982 * c.r + 0.6806995451 * c.g + 0.1073969566 * c.b;
    float s = 0.0883024619 * c.r + 0.2817188376 * c.g + 0.6299787005 * c.b;
    float l_ = cs_cbrt(l);
    float m_ = cs_cbrt(m);
    float s_ = cs_cbrt(s);
    return float3(
        0.2104542553 * l_ + 0.7936177850 * m_ - 0.0040720468 * s_,
        1.9779984951 * l_ - 2.4285922050 * m_ + 0.4505937099 * s_,
        0.0259040371 * l_ + 0.7827717662 * m_ - 0.8086757660 * s_);
}

float3 cs_oklab_to_linear(float3 c) {
    float l_ = c.x + 0.3963377774 * c.y + 0.2158037573 * c.z;
    float m_ = c.x - 0.1055613458 * c.y - 0.0638541728 * c.z;
    float s_ = c.x - 0.0894841775 * c.y - 1.2914855480 * c.z;
    float l = l_ * l_ * l_;
    float m = m_ * m_ * m_;
    float s = s_ * s_ * s_;
    return float3(
         4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
        -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
        -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s);
}

// sRGB（D65）のリニア ⇔ XYZ（IEC 61966-2-1）
float3 cs_linear_to_xyz(float3 c) {
    return float3(
        0.4124564 * c.r + 0.3575761 * c.g + 0.1804375 * c.b,
        0.2126729 * c.r + 0.7151522 * c.g + 0.0721750 * c.b,
        0.0193339 * c.r + 0.1191920 * c.g + 0.9503041 * c.b);
}

float3 cs_xyz_to_linear(float3 c) {
    return float3(
         3.2404542 * c.x - 1.5371385 * c.y - 0.4985314 * c.z,
        -0.9692660 * c.x + 1.8760108 * c.y + 0.0415560 * c.z,
         0.0556434 * c.x - 0.2040259 * c.y + 1.0572252 * c.z);
}

// CIE 15: ε = 216/24389、κ = 24389/27
float cs_lab_f(float t) {
    return t > 0.008856452 ? cs_cbrt(t) : (903.2963 * t + 16.0) / 116.0;
}

float cs_lab_finv(float f) {
    float f3 = f * f * f;
    return f3 > 0.008856452 ? f3 : (116.0 * f - 16.0) / 903.2963;
}

float3 cs_xyz_to_lab(float3 c) {
    float fx = cs_lab_f(c.x / 0.95047);
    float fy = cs_lab_f(c.y);
    float fz = cs_lab_f(c.z / 1.08883);
    return float3(116.0 * fy - 16.0, 500.0 * (fx - fy), 200.0 * (fy - fz));
}

float3 cs_lab_to_xyz(float3 c) {
    float fy = (c.x + 16.0) / 116.0;
    float fx = fy + c.y / 500.0;
    float fz = fy - c.z / 200.0;
    return float3(cs_lab_finv(fx) * 0.95047, cs_lab_finv(fy), cs_lab_finv(fz) * 1.08883);
}

// (L, a, b) → (色相 0〜1 周, C, L)
float3 cs_lab_to_polar(float3 v) {
    return float3(frac(atan2(v.z, v.y) / CS_TAU + 1.0), length(float2(v.y, v.z)), v.x);
}

float3 cs_polar_to_lab(float3 p) {
    return float3(p.z, p.y * cos(p.x * CS_TAU), p.y * sin(p.x * CS_TAU));
}

float cs_hue_of(float3 c, float mx, float mn) {
    float d = mx - mn;
    float h = 0.0;
    if (d > 0.000001) {
        if (mx == c.r) {
            h = (c.g - c.b) / d;
        } else if (mx == c.g) {
            h = (c.b - c.r) / d + 2.0;
        } else {
            h = (c.r - c.g) / d + 4.0;
        }
    }
    return frac(h / 6.0 + 1.0);
}

float3 cs_hue_rgb(float h) {
    float3 p = abs(frac(float3(h, h, h) + float3(1.0, 2.0 / 3.0, 1.0 / 3.0)) * 6.0 - 3.0);
    return saturate(p - 1.0);
}

float3 cs_rgb_to_hsv(float3 c) {
    float mx = max(c.r, max(c.g, c.b));
    float mn = min(c.r, min(c.g, c.b));
    float s = mx > 0.000001 ? (mx - mn) / mx : 0.0;
    return float3(cs_hue_of(c, mx, mn), s, mx);
}

float3 cs_hsv_to_rgb(float3 c) {
    return c.z * lerp(float3(1.0, 1.0, 1.0), cs_hue_rgb(c.x), saturate(c.y));
}

float3 cs_rgb_to_hsl(float3 c) {
    float mx = max(c.r, max(c.g, c.b));
    float mn = min(c.r, min(c.g, c.b));
    float l = (mx + mn) * 0.5;
    float den = 1.0 - abs(2.0 * l - 1.0);
    float s = den > 0.000001 ? (mx - mn) / den : 0.0;
    return float3(cs_hue_of(c, mx, mn), s, l);
}

float3 cs_hsl_to_rgb(float3 c) {
    float chroma = (1.0 - abs(2.0 * c.z - 1.0)) * saturate(c.y);
    return (cs_hue_rgb(c.x) - 0.5) * chroma + c.z;
}

float3 cs_rgb_to_hwb(float3 c) {
    float mx = max(c.r, max(c.g, c.b));
    float mn = min(c.r, min(c.g, c.b));
    return float3(cs_hue_of(c, mx, mn), mn, 1.0 - mx);
}

float3 cs_hwb_to_rgb(float3 c) {
    float w = max(c.y, 0.0);
    float b = max(c.z, 0.0);
    float sum = w + b;
    if (sum > 1.0) {
        w = w / sum;
        b = b / sum;
    }
    return cs_hue_rgb(c.x) * (1.0 - w - b) + w;
}

// リニアが sRGB の範囲に入っているか。float32 の誤差の分だけ、値の大きさに比例して許す
// （決まった幅で許すと、値の小さい暗い色で切り詰めたときに色相がずれる）
bool cs_in_gamut(float3 lin) {
    float e = max(abs(lin.r), max(abs(lin.g), abs(lin.b))) * 0.000002 + 0.000000001;
    return all(lin >= -e) && all(lin <= 1.0 + e);
}

// Oklch (h, C, L) をリニアへ。sRGB に無い色は、明るさと色相を保ったまま C を下げて収める（二分探索 16 回）
float3 cs_oklch_to_linear_fit(float3 p) {
    float3 lab = cs_polar_to_lab(p);
    float3 lin = cs_oklab_to_linear(lab);
    if (!cs_in_gamut(lin)) {
        float lo = 0.0;
        float hi = max(p.y, 0.0);
        [loop]
        for (int i = 0; i < 16; i++) {
            float mid = (lo + hi) * 0.5;
            float3 t = cs_oklab_to_linear(cs_polar_to_lab(float3(p.x, mid, p.z)));
            if (cs_in_gamut(t)) {
                lo = mid;
            } else {
                hi = mid;
            }
        }
        lin = cs_oklab_to_linear(cs_polar_to_lab(float3(p.x, lo, p.z)));
    }
    return lin;
}

// sRGB → 色空間の値
float3 cs_to_space(float3 c, float space) {
    float3 r = c;
    if (space > 8.5) {
        r = cs_rgb_to_hwb(c);
    } else if (space > 7.5) {
        r = cs_linear_to_xyz(cs_to_linear(c));
    } else if (space > 6.5) {
        r = cs_lab_to_polar(cs_linear_to_oklab(cs_to_linear(c)));
    } else if (space > 5.5) {
        r = cs_lab_to_polar(cs_xyz_to_lab(cs_linear_to_xyz(cs_to_linear(c))));
    } else if (space > 4.5) {
        r = cs_xyz_to_lab(cs_linear_to_xyz(cs_to_linear(c)));
    } else if (space > 3.5) {
        r = cs_rgb_to_hsl(c);
    } else if (space > 2.5) {
        r = cs_rgb_to_hsv(c);
    } else if (space > 1.5) {
        r = cs_linear_to_oklab(cs_to_linear(c));
    } else if (space > 0.5) {
        r = cs_to_linear(c);
    }
    return r;
}

// 色空間の値 → sRGB（0〜1）。Oklch だけは C を下げて sRGB に収め、ほかは切り詰める
float3 cs_from_space(float3 v, float space) {
    float3 r = saturate(v);
    if (space > 8.5) {
        r = saturate(cs_hwb_to_rgb(v));
    } else if (space > 7.5) {
        r = cs_to_srgb(cs_xyz_to_linear(v));
    } else if (space > 6.5) {
        r = cs_to_srgb(cs_oklch_to_linear_fit(v));
    } else if (space > 5.5) {
        r = cs_to_srgb(cs_xyz_to_linear(cs_lab_to_xyz(cs_polar_to_lab(v))));
    } else if (space > 4.5) {
        r = cs_to_srgb(cs_xyz_to_linear(cs_lab_to_xyz(v)));
    } else if (space > 3.5) {
        r = saturate(cs_hsl_to_rgb(v));
    } else if (space > 2.5) {
        r = saturate(cs_hsv_to_rgb(v));
    } else if (space > 1.5) {
        r = cs_to_srgb(cs_oklab_to_linear(v));
    } else if (space > 0.5) {
        r = cs_to_srgb(v);
    }
    return r;
}

bool cs_is_polar(float space) {
    return (space > 2.5 && space < 4.5) || (space > 5.5 && space < 7.5) || space > 8.5;
}

// 色相を持たない（無彩色の）値か
bool cs_no_hue(float3 v, float space) {
    bool r = v.y < 0.0001;
    if (space > 8.5) {
        r = v.y + v.z > 0.9999;
    } else if (space > 6.5) {
        r = v.y < 0.0002;
    } else if (space > 5.5) {
        r = v.y < 0.05;
    }
    return r;
}

// 色空間の値どうしの補間。a0 / a1 は不透明度で、乗算済みのまま混ぜる（透明へ向かっても黒ずまない。CSS と同じ）。
// 色相のある色空間では色相だけは乗算せず、無彩色の側は相手の色相に合わせる。hue_long > 0.5 で長い方を回る。
// 戻り値の xyz は色空間の値（cs_from_space で sRGB に戻す）、w は不透明度
float4 cs_mix_values(float3 v0, float a0, float3 v1, float a1, float u, float space, float hue_long) {
    float a = lerp(a0, a1, u);
    float3 v = v0;
    if (cs_is_polar(space)) {
        float3 x0 = v0;
        float3 x1 = v1;
        if (cs_no_hue(x0, space)) {
            x0.x = x1.x;
        } else if (cs_no_hue(x1, space)) {
            x1.x = x0.x;
        }
        float dh = x1.x - x0.x;
        if (hue_long > 0.5) {
            if (dh > 0.0 && dh < 0.5) {
                dh = dh - 1.0;
            } else if (dh <= 0.0 && dh > -0.5) {
                dh = dh + 1.0;
            }
        } else {
            if (dh > 0.5) {
                dh = dh - 1.0;
            } else if (dh < -0.5) {
                dh = dh + 1.0;
            }
        }
        float2 yz = lerp(float2(x0.y, x0.z) * a0, float2(x1.y, x1.z) * a1, u);
        yz = a > 0.000001 ? yz / a : lerp(float2(x0.y, x0.z), float2(x1.y, x1.z), u);
        v = float3(frac(x0.x + dh * u + 1.0), yz.x, yz.y);
    } else {
        float3 pc = lerp(v0 * a0, v1 * a1, u);
        v = a > 0.000001 ? pc / a : lerp(v0, v1, u);
    }
    return float4(v, a);
}

// ストレートの sRGB 2 色を色空間で補間する。戻り値はストレートの sRGB と不透明度
float4 cs_mix(float4 c0, float4 c1, float u, float space, float hue_long) {
    float3 v0 = cs_to_space(c0.rgb, space);
    float3 v1 = cs_to_space(c1.rgb, space);
    float4 m = cs_mix_values(v0, c0.a, v1, c1.a, u, space, hue_long);
    return float4(cs_from_space(m.xyz, space), m.w);
}

// 色相を turns 周だけ回す。space: 3 HSV / 4 HSL / 6 LCh / 7 Oklch / 9 HWB（それ以外は HSV）。
// Oklch と LCh は明るさと C を保つ（Oklch は sRGB に無ければ C を下げる）
float3 cs_hue_shift(float3 c, float turns, float space) {
    float sp = cs_is_polar(space) ? space : 3.0;
    float3 v = cs_to_space(c, sp);
    v.x = frac(v.x + turns + 1.0);
    return cs_from_space(v, sp);
}

// 鮮やかさを k 倍にする。space: 0 sRGB（Rec.709 の輝度との間で伸ばす。従来の式）/ 3 HSV / 4 HSL / 6 LCh / 7 Oklch
float3 cs_scale_chroma(float3 c, float k, float space) {
    float3 r = c;
    if (cs_is_polar(space) && space < 8.5) {
        float3 v = cs_to_space(c, space);
        v.y = max(v.y * k, 0.0);
        r = cs_from_space(v, space);
    } else {
        float y = dot(c, float3(0.2126, 0.7152, 0.0722));
        r = saturate(lerp(float3(y, y, y), c, k));
    }
    return r;
}

// 明るさ（0〜1）。space: 0 sRGB（Rec.709 をガンマのまま。従来の式）/ 1 リニア（相対輝度 Y）/ 2・7 Oklab の L / 5・6 Lab の L / 3 HSV の V / 4 HSL の L
float cs_lightness(float3 c, float space) {
    float r = dot(c, float3(0.2126, 0.7152, 0.0722));
    if (space > 6.5 && space < 7.5) {
        r = cs_linear_to_oklab(cs_to_linear(c)).x;
    } else if (space > 4.5 && space < 6.5) {
        r = cs_xyz_to_lab(cs_linear_to_xyz(cs_to_linear(c))).x / 100.0;
    } else if (space > 3.5 && space < 4.5) {
        r = cs_rgb_to_hsl(c).z;
    } else if (space > 2.5 && space < 3.5) {
        r = max(c.r, max(c.g, c.b));
    } else if (space > 1.5 && space < 2.5) {
        r = cs_linear_to_oklab(cs_to_linear(c)).x;
    } else if (space > 0.5 && space < 1.5) {
        r = dot(cs_to_linear(c), float3(0.2126729, 0.7151522, 0.0721750));
    }
    return r;
}

// CIEDE2000（Sharma, Wu, Dalal 2005）。Lab（D65）の値どうし。戻り値は ΔE00（0〜100 程度）
float cs_ciede2000(float3 lab1, float3 lab2) {
    float c1 = length(lab1.yz);
    float c2 = length(lab2.yz);
    float cb = (c1 + c2) * 0.5;
    float cb7 = pow(cb, 7.0);
    float g = 0.5 * (1.0 - sqrt(cb7 / (cb7 + 6103515625.0)));
    float a1p = lab1.y * (1.0 + g);
    float a2p = lab2.y * (1.0 + g);
    float c1p = length(float2(a1p, lab1.z));
    float c2p = length(float2(a2p, lab2.z));
    float h1p = (abs(a1p) + abs(lab1.z)) > 0.0 ? atan2(lab1.z, a1p) : 0.0;
    float h2p = (abs(a2p) + abs(lab2.z)) > 0.0 ? atan2(lab2.z, a2p) : 0.0;
    if (h1p < 0.0) {
        h1p = h1p + CS_TAU;
    }
    if (h2p < 0.0) {
        h2p = h2p + CS_TAU;
    }
    float dl = lab2.x - lab1.x;
    float dc = c2p - c1p;
    float dh = 0.0;
    float hbp = h1p + h2p;
    if (c1p * c2p > 0.0) {
        dh = h2p - h1p;
        if (dh > 3.14159265) {
            dh = dh - CS_TAU;
        } else if (dh < -3.14159265) {
            dh = dh + CS_TAU;
        }
        if (abs(h1p - h2p) > 3.14159265) {
            hbp = (h1p + h2p < CS_TAU) ? (h1p + h2p + CS_TAU) * 0.5 : (h1p + h2p - CS_TAU) * 0.5;
        } else {
            hbp = (h1p + h2p) * 0.5;
        }
    }
    float dhh = 2.0 * sqrt(c1p * c2p) * sin(dh * 0.5);
    float lbp = (lab1.x + lab2.x) * 0.5;
    float cbp = (c1p + c2p) * 0.5;
    float t = 1.0 - 0.17 * cos(hbp - 0.523598776) + 0.24 * cos(2.0 * hbp)
        + 0.32 * cos(3.0 * hbp + 0.104719755) - 0.20 * cos(4.0 * hbp - 1.099557429);
    float dtheta = 0.523598776 * exp(-pow((hbp * 57.29577951 - 275.0) / 25.0, 2.0));
    float cbp7 = pow(cbp, 7.0);
    float rc = 2.0 * sqrt(cbp7 / (cbp7 + 6103515625.0));
    float l50 = (lbp - 50.0) * (lbp - 50.0);
    float sl = 1.0 + 0.015 * l50 / sqrt(20.0 + l50);
    float sc = 1.0 + 0.045 * cbp;
    float sh = 1.0 + 0.015 * cbp * t;
    float rt = -sin(2.0 * dtheta) * rc;
    float tl = dl / sl;
    float tc = dc / sc;
    float th = dhh / sh;
    return sqrt(max(tl * tl + tc * tc + th * th + rt * tc * th, 0.0));
}

// 2 色の差。metric: 0 RGB / 1 YCbCr（BT.709 の色差だけ）/ 2 Oklab / 3 CIEDE2000。黒と白の差がおよそ 1
float cs_distance(float3 c0, float3 c1, float metric) {
    float r = length(c0 - c1) * 0.57735027;
    if (metric > 2.5) {
        float3 l0 = cs_xyz_to_lab(cs_linear_to_xyz(cs_to_linear(c0)));
        float3 l1 = cs_xyz_to_lab(cs_linear_to_xyz(cs_to_linear(c1)));
        r = cs_ciede2000(l0, l1) / 100.0;
    } else if (metric > 1.5) {
        r = length(cs_linear_to_oklab(cs_to_linear(c0)) - cs_linear_to_oklab(cs_to_linear(c1)));
    } else if (metric > 0.5) {
        float3 d = c0 - c1;
        float cb = dot(d, float3(-0.1146, -0.3854, 0.5));
        float cr = dot(d, float3(0.5, -0.4542, -0.0458));
        r = length(float2(cb, cr)) * 1.41421356;
    }
    return r;
}
// ==== colorspace.hlsl ここまで ====

// 乗算済みの画素を、リニアの乗算済みにする（ストレートに戻してリニアへ。1 を超える値・負の値もそのまま延ばす）
float3 linear_premul(float4 s) {
    float3 r = float3(0.0, 0.0, 0.0);
    if (s.a > 0.0) {
        float3 c = s.rgb / s.a;
        r = float3(cs_lin1(c.r), cs_lin1(c.g), cs_lin1(c.b)) * s.a;
    }
    return r;
}

// 以下 3 つは ps_mosaic_h の複製（正本は ps_mosaic_h。変更時は両方直す）
float2 object_pixel_to_screen(float2 sourcePos, float2 resolution) {
    float localX = (sourcePos.x + 0.5 - resolution.x * 0.5 - c5.z) * c4.z;
    float localY = (sourcePos.y + 0.5 - resolution.y * 0.5 - c5.w) * c4.w;

    return float2(
        c4.x + localX * c5.x - localY * c5.y,
        c4.y + localX * c5.y + localY * c5.x
    );
}

float2 screen_to_object_pixel(float2 screenPos, float2 resolution) {
    float dx = screenPos.x - c4.x;
    float dy = screenPos.y - c4.y;

    float invX = dx * c5.x + dy * c5.y;
    float invY = -dx * c5.y + dy * c5.x;

    float safeScaleX = c4.z;
    float safeScaleY = c4.w;

    if (abs(safeScaleX) < 0.00001) {
        safeScaleX = 0.00001;
    }
    if (abs(safeScaleY) < 0.00001) {
        safeScaleY = 0.00001;
    }

    return float2(
        invX / safeScaleX + resolution.x * 0.5 + c5.z - 0.5,
        invY / safeScaleY + resolution.y * 0.5 + c5.w - 0.5
    );
}

float2 block_index(float2 sourcePos, float2 resolution, float psize, float gridMode) {
    float2 b = floor(sourcePos / psize);
    if (gridMode > 1.5) {
        b = floor((sourcePos - resolution * 0.5) / psize);
    } else if (gridMode > 0.5) {
        b = floor(object_pixel_to_screen(sourcePos, resolution) / psize);
    }
    return b;
}

// 縮小バッファの 1 画素 = 1 ブロック。そのブロックに属する画素（Premultiplied のまま）を平均する。
// ブロックの外接矩形を画素で走査し、属するかは block_index で判定する（回転・拡大しても同じ規則）
float4 ps_mosaic_h_average(float4 pos : SV_Position) : SV_Target {
    float width  = max(c0.x, 1.0);
    float height = max(c0.y, 1.0);
    float psize  = max(c0.z, 1.0);
    float gridMode = c3.y;
    float2 resolution = float2(width, height);
    float2 block = floor(pos.xy) + c3.zw;

    float2 lo = block * psize;
    float2 hi = lo + float2(psize, psize);
    if (gridMode > 1.5) {
        lo = lo + resolution * 0.5;
        hi = hi + resolution * 0.5;
    } else if (gridMode > 0.5) {
        float2 p0 = screen_to_object_pixel(block * psize, resolution);
        float2 p1 = screen_to_object_pixel(float2(block.x + 1.0, block.y) * psize, resolution);
        float2 p2 = screen_to_object_pixel(float2(block.x, block.y + 1.0) * psize, resolution);
        float2 p3 = screen_to_object_pixel(float2(block.x + 1.0, block.y + 1.0) * psize, resolution);
        lo = min(min(p0, p1), min(p2, p3));
        hi = max(max(p0, p1), max(p2, p3));
    }

    // 画素 x の中心は x + 0.5。画面固定は逆変換の丸めを見込んで 1 画素ずつ広げて走査し、
    // 判定は block_index に任せる。オブジェクト固定 / 中心は整数刻みで誤差が無いので、
    // 中心が [lo, hi) に入る画素ちょうど（ブロック 1 個ぶん）だけを走査する
    float fx0 = floor(lo.x - 0.5);
    float fx1 = ceil(hi.x - 0.5);
    float fy0 = floor(lo.y - 0.5);
    float fy1 = ceil(hi.y - 0.5);
    if (gridMode < 0.5 || gridMode > 1.5) {
        fx0 = ceil(lo.x - 0.5);
        fx1 = ceil(hi.x - 0.5) - 1.0;
        fy0 = ceil(lo.y - 0.5);
        fy1 = ceil(hi.y - 0.5) - 1.0;
    }
    fx0 = clamp(fx0, 0.0, width - 1.0);
    fx1 = clamp(fx1, 0.0, width - 1.0);
    fy0 = clamp(fy0, 0.0, height - 1.0);
    fy1 = clamp(fy1, 0.0, height - 1.0);
    int x0 = (int)fx0;
    int x1 = (int)fx1;
    int y0 = (int)fy0;
    int y1 = (int)fy1;

    // v1.10: リニアで平均（c6.z）。sum は今までどおり乗算済みのまま足し、リニアの色は sum_lin に別に足す
    bool linAvg = c6.z > 0.5;
    float4 sum = float4(0.0, 0.0, 0.0, 0.0);
    float3 sum_lin = float3(0.0, 0.0, 0.0);
    float cnt = 0.0;
    [loop]
    for (int y = y0; y <= y1; y++) {
        [loop]
        for (int x = x0; x <= x1; x++) {
            float2 b = block_index(float2((float)x + 0.5, (float)y + 0.5), resolution, psize, gridMode);
            if (b.x == block.x && b.y == block.y) {
                float4 px = src_tex.Load(int3(x, y, 0));
                sum += px;
                if (linAvg) {
                    sum_lin += linear_premul(px);
                }
                cnt += 1.0;
            }
        }
    }

    if (cnt < 0.5) {
        // 空のブロック。メインのパスは中心の色に戻す（アルファ -1 を目印にする）
        return float4(0.0, 0.0, 0.0, -1.0);
    }
    if (linAvg && sum.a > 0.0) {
        // 不透明度で重みを付けたリニアの平均を sRGB へ戻し、平均の不透明度を掛け直す（乗算済み）
        float3 c = sum_lin / sum.a;
        float a = sum.a / cnt;
        return float4(float3(cs_srgb1(c.r), cs_srgb1(c.g), cs_srgb1(c.b)) * a, a);
    }
    return sum / cnt;
}
]]

local function clamp(v, lo, hi)
  if v < lo then return lo end
  if v > hi then return hi end
  return v
end

if obj.w <= 0 or obj.h <= 0 then
  return
end

local ap = 0
if alpha_protect == 1 or alpha_protect == true then
  ap = 1
end

local dm = math.floor(clamp(tonumber(dither_mode) or 0, 0, 2))
local pm = math.floor(clamp(tonumber(palette_mode) or 0, 0, 3))
local es = math.floor(clamp(tonumber(edge_style) or 0, 0, 1))
local gm = math.floor(clamp(tonumber(grid_mode) or 0, 0, 2))
local cm = math.floor(clamp(tonumber(color_mode) or 0, 0, 1))
-- v1.10: リニアで平均（平均のパスだけが見る）と、GameBoy の色差（0 RGB は v1.01 と同じ）
local lin_avg = (avg_linear == 1 or avg_linear == true) and 1 or 0
local cdiff = math.floor(clamp(tonumber(color_diff) or 0, 0, 3))

local psize = math.max(tonumber(pixel_size) or 1, 1)
-- 色数 0 / 1 は「無効」（量子化しない）。2 以上は原作と同じ
local levels = tonumber(color_levels) or 0
if levels < 2 then
  levels = 0
end

-- Compose the output-item transform with the script-relative transform.（原作と同じ）
local output_x = obj.getvalue("x") or obj.x or 0
local output_y = obj.getvalue("y") or obj.y or 0
local output_sx = obj.getvalue("sx") or 1
local output_sy = obj.getvalue("sy") or 1
local output_cx = obj.getvalue("cx") or 0
local output_cy = obj.getvalue("cy") or 0
local output_rz = obj.getvalue("rz") or 0

local base_x = output_x + (obj.ox or 0)
local base_y = output_y + (obj.oy or 0)
local scale_x = output_sx * (obj.sx or 1)
local scale_y = output_sy * (obj.sy or 1)
local center_x = output_cx + (obj.cx or 0)
local center_y = output_cy + (obj.cy or 0)
local rz = (output_rz + (obj.rz or 0)) * math.pi / 180
local cos_r = math.cos(rz)
local sin_r = math.sin(rz)
local screen_center_x = (obj.screen_w or 0) * 0.5 + base_x
local screen_center_y = (obj.screen_h or 0) * 0.5 + base_y

local W, H = obj.w, obj.h

-- 画素の中心 (px, py) が属するブロックの番号（HLSL の block_index と同じ式）
local function block_of(px, py)
  if gm == 2 then
    return math.floor((px - W * 0.5) / psize), math.floor((py - H * 0.5) / psize)
  elseif gm == 1 then
    local lx = (px + 0.5 - W * 0.5 - center_x) * scale_x
    local ly = (py + 0.5 - H * 0.5 - center_y) * scale_y
    local sx = screen_center_x + lx * cos_r - ly * sin_r
    local sy = screen_center_y + lx * sin_r + ly * cos_r
    return math.floor(sx / psize), math.floor(sy / psize)
  end
  return math.floor(px / psize), math.floor(py / psize)
end

-- 平均の縮小バッファ。1 画素 = 1 ブロック。四隅の画素のブロックから範囲を決め、
-- HLSL（float）と Lua（double）の丸めの差を吸収するため 1 ブロックずつ広げる
local MAP = "cache:mosaic_h/map"
local MAP_MAX = 16384
local map_x, map_y, map_w, map_h = 0, 0, 1, 1
if cm == 1 and psize <= 1 and gm ~= 1 then
  cm = 0                                  -- 1 画素のブロックは平均しても中心の色と同じ
end
if cm == 1 then
  local kx0, ky0 = math.huge, math.huge
  local kx1, ky1 = -math.huge, -math.huge
  for _, c in ipairs({ { 0.5, 0.5 }, { W - 0.5, 0.5 }, { 0.5, H - 0.5 }, { W - 0.5, H - 0.5 } }) do
    local bx, by = block_of(c[1], c[2])
    kx0 = math.min(kx0, bx)
    kx1 = math.max(kx1, bx)
    ky0 = math.min(ky0, by)
    ky1 = math.max(ky1, by)
  end
  map_x, map_y = kx0 - 1, ky0 - 1
  map_w, map_h = kx1 - kx0 + 3, ky1 - ky0 + 3
  if map_w > MAP_MAX or map_h > MAP_MAX or map_w ~= map_w or map_h ~= map_h then
    cm = 0                                -- 縮小バッファが作れない大きさなら中心の色で描く
    map_x, map_y, map_w, map_h = 0, 0, 1, 1
  end
end

local params = {
  W,
  H,
  psize,
  levels,

  math.max(tone_steps, 0),
  dm,
  clamp(dither_strength, 0, 100),
  clamp(edge_strength, 0, 100),

  ap,
  clamp(alpha_threshold, 0, 255),
  pm,
  cm,

  es, gm, map_x, map_y,

  screen_center_x, screen_center_y, scale_x, scale_y,
  cos_r, sin_r, center_x, center_y,

  map_w, map_h, lin_avg, cdiff,
}

-- 中心の色のときも t1 を空けないよう 1x1 で用意する
obj.clearbuffer(MAP, map_w, map_h)
if cm == 1 then
  obj.pixelshader("ps_mosaic_h_average", MAP, { "object" }, params, "copy")
end
obj.pixelshader("ps_mosaic_h", "object", { "object", MAP }, params, "copy", "clamp")
